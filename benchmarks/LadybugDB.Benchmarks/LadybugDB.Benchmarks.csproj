<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LadybugDB.Benchmarks</RootNamespace>
    <AssemblyName>LadybugDB.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet wants Release; this skeleton just needs to build and exit cleanly. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LadybugDB.Benchmarks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LadybugDB\LadybugDB.csproj" />
  </ItemGroup>

</Project>
